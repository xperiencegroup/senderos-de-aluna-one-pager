<IfModule mod_rewrite.c>
RewriteEngine On

# www -> non-www
RewriteCond %{HTTP_HOST} ^www\.aluna\.gt$ [NC]
RewriteRule ^ https://aluna.gt%{REQUEST_URI} [L,R=301]

RewriteBase /senderosdealuna/
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /senderosdealuna/index.html [L]
</IfModule>

# index.html nunca en caché; assets con hash, caché larga
<IfModule mod_headers.c>
<FilesMatch "(^$|\.html$)">
Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|woff2?|svg|png|jpe?g|webp)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
